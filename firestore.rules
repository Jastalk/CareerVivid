rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // 🛡️ ADMIN CHECK (Robust & Fail-Safe)
    // ---------------------------------------------------------
    // Admin is proven by a custom claim minted server-side, or by the role on the
    // user document. The previous email bypass was removed: it granted whoever
    // controlled a single mailbox unconditional read/write over every collection,
    // which made that one account's password the only thing protecting the
    // database. A custom claim cannot be reached by knowing an address.
    //
    // Set the claim with:
    //   admin.auth().setCustomUserClaims(uid, { admin: true })
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'academic_partner', 'super_admin']
        )
      );
    }

    function isBusinessPartner() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business_partner' ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []) != null &&
           'business_partner' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []))
        );
    }

    function isAgencyPartner() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agency_partner' ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []) != null &&
           'agency_partner' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []))
        );
    }

    function isUserOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isKnownClientApp(appKey) {
      return appKey in [
        'careervivid',
        'createvivid',
        'visa-interview-prep',
        'green-card-interview-prep'
      ];
    }

    function safeUserAppMembershipFields() {
      return [
        'appKey',
        'userId',
        'enabled',
        'createdAt',
        'updatedAt',
        'lastActiveAt',
        'locale',
        'marketingChannel',
        'onboardingComplete'
      ];
    }

    function hasSafeUserAppMembership(userId, appKey) {
      return isKnownClientApp(appKey) &&
        request.resource.data.keys().hasOnly(safeUserAppMembershipFields()) &&
        request.resource.data.get('appKey', appKey) == appKey &&
        request.resource.data.get('userId', userId) == userId;
    }

    function canAccessAppUserSpace(appKey, userId) {
      return isKnownClientApp(appKey) && (isUserOwner(userId) || isAdmin());
    }

    function canReadUserRoot(userId) {
      return isUserOwner(userId) || isAdmin();
    }

    function protectedUserFields() {
      return [
        'downloadCredits',
        'creditsUsed',
        'aiUsage',
        'plan',
        'resumeLimit',
        'expiresAt',
        'promotions',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'stripeSubscriptionStatus',
        'subscriptionStatus',
        'billingStatus',
        'cancelAtPeriodEnd',
        'currentPeriodStart',
        'currentPeriodEnd',
        'priceId',
        'role',
        'roles',
        'seats'
      ];
    }

    function touchesProtectedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());
    }

    function hasSafeCreatePromotions() {
      return !request.resource.data.keys().hasAny(['promotions']) ||
        (
          request.resource.data.promotions is map &&
          request.resource.data.promotions.get('isPremium', false) == false &&
          request.resource.data.promotions.get('tokenCredits', 0) == 0
        );
    }

    function hasSafeCreateAiUsage() {
      return !request.resource.data.keys().hasAny(['aiUsage']) ||
        (
          request.resource.data.aiUsage is map &&
          request.resource.data.aiUsage.get('count', 0) == 0 &&
          request.resource.data.aiUsage.get('monthlyLimit', 100) <= 100
        );
    }

    function hasSafeUserCreateEntitlements(userId) {
      return request.resource.data.get('uid', userId) == userId &&
        request.resource.data.get('downloadCredits', 0) == 0 &&
        request.resource.data.get('plan', 'free') == 'free' &&
        request.resource.data.get('resumeLimit', 1) <= 1 &&
        request.resource.data.get('role', 'user') == 'user' &&
        !request.resource.data.keys().hasAny([
          'expiresAt',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'stripeSubscriptionStatus',
          'subscriptionStatus',
          'billingStatus',
          'cancelAtPeriodEnd',
          'currentPeriodStart',
          'currentPeriodEnd',
          'priceId',
          'roles',
          'creditsUsed',
          'seats'
        ]) &&
        hasSafeCreatePromotions() &&
        hasSafeCreateAiUsage();
    }

    // ---------------------------------------------------------
    // 👤 CORE USER DATA (Recursive - Covers EVERYTHING)
    // ---------------------------------------------------------
    match /users/{userId} {
      allow get: if canReadUserRoot(userId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (isUserOwner(userId) && hasSafeUserCreateEntitlements(userId));
      allow update: if isAdmin() || (isUserOwner(userId) && !touchesProtectedUserFields());
      allow delete: if isAdmin();

      match /resumes/{resumeId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isBusinessPartner())
                    || resource.data.shareConfig.enabled == true;
        allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());

        /*
         * Reviewer feedback on a shared resume.
         *
         * `create, update` used to be one rule: any signed-in user, on any
         * publicly-shared resume, could write ANY document in this collection —
         * including one they did not author. So a reviewer could silently
         * rewrite someone else's comment, or blank every comment on a stranger's
         * resume, and the edit would still be attributed to the original author.
         *
         * Leaving feedback is a real feature and stays open to any signed-in
         * viewer of a shared resume. What is now separated out is *editing*:
         * create and update are distinct rules, and update/delete are limited to
         * the comment's author (plus the resume owner and admins, who moderate
         * their own page).
         *
         * Authorship is the `userId` field the client already stamps (see
         * src/services/commentService.ts addComment), read via
         * `.get('userId', '')` so a legacy comment written without one fails the
         * check instead of raising a rule-evaluation error — closed, not open.
         */
        match /comments/{commentId} {
          allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isBusinessPartner())
                      || get(/databases/$(database)/documents/users/$(userId)/resumes/$(resumeId)).data.shareConfig.enabled == true;

          // Unchanged audience, one added condition: a non-owner must stamp the
          // comment with their OWN uid. Without it a reviewer could post under
          // someone else's name, and there would be no author for the update
          // and delete rules below to check against.
          allow create: if request.auth != null && (
            request.auth.uid == userId || isAdmin() ||
            (
              get(/databases/$(database)/documents/users/$(userId)/resumes/$(resumeId)).data.shareConfig.enabled == true &&
              request.resource.data.get('userId', '') == request.auth.uid
            )
          );

          // Authors may edit their own comment, and may not reassign it to
          // someone else on the way through.
          //
          // The share check is repeated here on purpose. Without it, revoking a
          // share would take away a reviewer's READ access (the rule above) and
          // leave their WRITE access intact: they could keep putting arbitrary
          // content into a resume that is no longer shared with anyone. Losing
          // the share has to end every non-owner write, not just new ones.
          allow update: if request.auth != null && (
            request.auth.uid == userId || isAdmin() ||
            (
              get(/databases/$(database)/documents/users/$(userId)/resumes/$(resumeId)).data.shareConfig.enabled == true &&
              resource.data.get('userId', '') == request.auth.uid &&
              request.resource.data.get('userId', '') == resource.data.get('userId', '')
            )
          );

          // Was owner/admin only. Authors can now retract their own comment —
          // the natural other half of being able to edit it, and gated on the
          // same live share for the same reason.
          allow delete: if request.auth != null && (
            request.auth.uid == userId || isAdmin() ||
            (
              get(/databases/$(database)/documents/users/$(userId)/resumes/$(resumeId)).data.shareConfig.enabled == true &&
              resource.data.get('userId', '') == request.auth.uid
            )
          );
        }

        /*
         * Drawn markup on a shared resume. Same hole as comments above: `create,
         * update` let any signed-in user overwrite any annotation on any shared
         * resume.
         *
         * Annotations differ from comments in one way that matters here: the
         * client (src/services/annotationService.ts uploadAnnotation) records
         * only an author *name*, no uid, and has no edit or delete path at all.
         * So requiring a uid stamp on create would break the feature outright.
         * Instead create keeps its existing audience while refusing a FORGED
         * stamp, and update/delete require a stamp that matches — which means
         * existing uid-less annotations are editable by the resume owner and
         * admins only. That is the fail-closed direction, and it takes nothing
         * away that the app can currently do.
         */
        match /annotations/{annotationId} {
          allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isBusinessPartner())
                      || get(/databases/$(database)/documents/users/$(userId)/resumes/$(resumeId)).data.shareConfig.enabled == true;

          allow create: if request.auth != null && (
            request.auth.uid == userId || isAdmin() ||
            (
              get(/databases/$(database)/documents/users/$(userId)/resumes/$(resumeId)).data.shareConfig.enabled == true &&
              request.resource.data.get('userId', request.auth.uid) == request.auth.uid
            )
          );

          // Same live-share requirement as comments: a revoked reviewer keeps
          // no write channel into a resume that is no longer shared.
          allow update: if request.auth != null && (
            request.auth.uid == userId || isAdmin() ||
            (
              get(/databases/$(database)/documents/users/$(userId)/resumes/$(resumeId)).data.shareConfig.enabled == true &&
              resource.data.get('userId', '') == request.auth.uid &&
              request.resource.data.get('userId', '') == resource.data.get('userId', '')
            )
          );

          allow delete: if request.auth != null && (
            request.auth.uid == userId || isAdmin() ||
            (
              get(/databases/$(database)/documents/users/$(userId)/resumes/$(resumeId)).data.shareConfig.enabled == true &&
              resource.data.get('userId', '') == request.auth.uid
            )
          );
        }
      }

      match /applicationProfile/{profileId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /applicationQueue/{queueId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /applicationRuns/{runId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());

        match /steps/{stepId} {
          allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
        }
      }

      // Gamification progress lives at progress/summary with an append-only
      // events subcollection (progress/summary/events/{dedupeId}). Owner
      // access is granted by the catch-all below. XP is client-awarded for
      // now (users can only affect their own totals); before shipping any
      // leaderboard or XP-gated rewards, move awarding into a Cloud Function
      // and restrict client writes to this namespace.
      match /{allChildren=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // ---------------------------------------------------------
    // 🛡️ ADMINS (Root Collection)
    // ---------------------------------------------------------
    match /admins/{adminId} {
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow create, read: if isAdmin();
    }

    // ---------------------------------------------------------
    // 📱 MULTI-APP DATA NAMESPACES
    // ---------------------------------------------------------
    // New mobile apps share Firebase Auth but keep all app-specific data
    // inside apps/{appKey}. Old CareerVivid collections are intentionally
    // untouched; new apps should not write into another user's app space.
    match /userApps/{userId} {
      allow read: if isUserOwner(userId) || isAdmin();
      allow write: if isAdmin();

      match /apps/{appKey} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow create, update: if isUserOwner(userId) && hasSafeUserAppMembership(userId, appKey);
        allow delete: if isUserOwner(userId) || isAdmin();
      }
    }

    match /apps/{appKey} {
      allow get, list: if isKnownClientApp(appKey) && isAdmin();
      allow write: if isAdmin() && isKnownClientApp(appKey);

      // Shared templates, localized questions, checklists, and other
      // app-owned content. Clients may read known app content; writes stay
      // admin/server-only.
      match /content/{document=**} {
        allow read: if isKnownClientApp(appKey);
        allow write: if isAdmin() && isKnownClientApp(appKey);
      }

      // Private per-user app data. Users can create, read, update, and delete
      // their own content inside this namespace, e.g.
      // apps/visa-interview-prep/users/{uid}/practiceSessions.
      match /users/{userId}/{document=**} {
        allow read, create, update, delete: if canAccessAppUserSpace(appKey, userId);
      }
    }


    // ---------------------------------------------------------
    // 🎟️ REFERRAL CODES (Root Collection)
    // ---------------------------------------------------------
    match /referralCodes/{code} {
      // Anyone logged in can read codes (to validate them).
      // Admins can read everything.
      allow read: if request.auth != null || isAdmin();
      
      // Creation/Updates:
      // 1. Admins: Always allowed.
      // 2. Users: Can create/update if the code document belongs to them (userId field matches).
      allow write: if isAdmin() || (request.auth != null && (resource == null || resource.data.userId == request.auth.uid));
    }

    // ---------------------------------------------------------
    // 💼 CLIENT PORTAL (Root Collection)
    // ---------------------------------------------------------
    match /client_projects/{projectId} {
      allow read: if (request.auth != null && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow write: if isAdmin(); 
      allow list: if isAdmin();

      match /tasks/{taskId} {
        allow read: if (request.auth != null && get(/databases/$(database)/documents/client_projects/$(projectId)).data.ownerId == request.auth.uid) || isAdmin();
        allow write: if isAdmin(); 
        
        allow update: if (request.auth != null && get(/databases/$(database)/documents/client_projects/$(projectId)).data.ownerId == request.auth.uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']);
      }
    }
    // ---------------------------------------------------------
    // 🌐 PUBLIC PORTFOLIOS (Public Read, Owner/Admin Write)
    // ---------------------------------------------------------
    /*
     * `create, update` as one rule checked only request.resource.data.userId —
     * the uid on the doc being WRITTEN — and never resource.data.userId, the uid
     * on the doc that is already there. Since the document id is public (it is
     * in the shared URL), any signed-in user could write their own uid into a
     * body addressed at someone else's document and overwrite it wholesale:
     * defacing or destroying a stranger's published portfolio, resume or theme.
     *
     * Split in two. Create still proves you are claiming the document for
     * yourself; update additionally requires that you already own the document
     * you are replacing, and that the write does not hand it to someone else.
     *
     * `.get('userId', '')` rather than a bare field read: a stored document that
     * somehow has no userId has no provable owner.
     *
     * Two things follow from the document id being public, and both are handled
     * by proving ownership of the PRIVATE portfolio of the same id rather than
     * by trusting the body:
     *
     *  - Create has to name a portfolio you actually own. Without that, anyone
     *    could claim a free id — and since unpublishing deletes the document
     *    (SharePortfolioModal deleteDoc), the id of any portfolio that has ever
     *    been published is both known and claimable. With `allow update` now
     *    requiring the stored userId to match, a squat would be permanent: the
     *    real owner could neither overwrite nor delete their own URL.
     *
     *  - Update has to survive a document the admin SDK created without a
     *    userId. functions/src/portfolioApi.ts writes this collection with
     *    set(..., {merge:true}) from applyPortfolioPatch, updatePortfolioProjects
     *    and updatePortfolioHero, and a merge-set CREATES the document when it
     *    is absent — so an agent edit on a never-published portfolio can leave a
     *    public mirror with no owner stamp. Matching on the private portfolio
     *    lets the owner publish over it; matching on `userId` alone would lock
     *    them out of their own id forever.
     */
    function ownsPrivatePortfolio(portfolioId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)/portfolios/$(portfolioId));
    }

    match /public_portfolios/{portfolioId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        ownsPrivatePortfolio(portfolioId)
      );
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          (resource.data.get('userId', '') == '' && ownsPrivatePortfolio(portfolioId))
        )
      );
      allow delete: if isAdmin() || (
        request.auth != null &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          (resource.data.get('userId', '') == '' && ownsPrivatePortfolio(portfolioId))
        )
      );
    }

    // ---------------------------------------------------------
    // 📄 PUBLIC RESUMES (Public Read, Owner/Admin Write)
    // ---------------------------------------------------------
    // Same overwrite hole as public_portfolios above, same split, and the same
    // id-squatting fix: the id is public, so claiming one has to mean proving
    // you own the private resume it mirrors. Nothing writes this collection from
    // the client today, which is the only reason the squat was never reachable.
    function ownsPrivateResume(resumeId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)/resumes/$(resumeId));
    }

    match /public_resumes/{resumeId} {
      allow read: if true;
      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        ownsPrivateResume(resumeId)
      );
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          (resource.data.get('userId', '') == '' && ownsPrivateResume(resumeId))
        )
      );
      allow delete: if isAdmin() || (
        request.auth != null &&
        (
          resource.data.get('userId', '') == request.auth.uid ||
          (resource.data.get('userId', '') == '' && ownsPrivateResume(resumeId))
        )
      );
    }

    // ---------------------------------------------------------
    // 🎨 USER THEMES (Public Read, Owner Write)
    // ---------------------------------------------------------
    // Same overwrite hole as public_portfolios above, same split.
    match /user_themes/{themeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('userId', '') == resource.data.get('userId', '');
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------
    // 📰 BLOG POSTS (Public Read)
    // ---------------------------------------------------------
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // ---------------------------------------------------------
    // 📬 CONTACT MESSAGES (Public Create, Admin Manage)
    // ---------------------------------------------------------
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 🗣️ FEEDBACK (Public Create, Admin Manage)
    // ---------------------------------------------------------
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // ⚠️ ERROR REPORTS (Public Create, Admin Manage)
    // ---------------------------------------------------------
    match /error_reports/{errorId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 🤝 PARTNER APPLICATIONS (Public Create, Admin Manage)
    // ---------------------------------------------------------
    match /partner_applications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // ⚙️ SYSTEM SETTINGS (Public Read, Admin Manage)
    // ---------------------------------------------------------
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // 📊 USAGE LOGS (Public Create, Admin Manage)
    // ---------------------------------------------------------
    match /usage_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 📈 ANALYTICS (Public Update, Admin Manage)
    // ---------------------------------------------------------
    match /analytics/{docId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 📧 EMAIL TEMPLATES (Admin Manage)
    // ---------------------------------------------------------
    match /email_templates/{templateId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------
    // 📨 MAIL (Admin Send)
    // ---------------------------------------------------------
    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 📢 MARKETING CAMPAIGNS (Admin Manage)
    // ---------------------------------------------------------
    match /campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------
    // 💬 MESSAGING QUEUE (Admin Manage)
    // ---------------------------------------------------------
    match /messaging_queue/{messageId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------
    // 📝 COMMUNITY POSTS (canonical collection)
    // ---------------------------------------------------------
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update: if request.auth != null && (request.auth.uid == resource.data.authorId || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metrics', 'updatedAt']));
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.authorId);
    }

    // Legacy 'posts' collection — kept for backward compatibility
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update: if request.auth != null && (request.auth.uid == resource.data.authorId || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metrics', 'updatedAt']));
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.authorId);
    }

    match /community_post_likes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Use !exists or get().data.userId check to ensure owner can delete
      allow delete: if request.auth != null && (isAdmin() || (exists(/databases/$(database)/documents/community_post_likes/$(likeId)) && get(/databases/$(database)/documents/community_post_likes/$(likeId)).data.userId == request.auth.uid));
    }

    match /post_likes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (isAdmin() || (exists(/databases/$(database)/documents/post_likes/$(likeId)) && get(/databases/$(database)/documents/post_likes/$(likeId)).data.userId == request.auth.uid));
    }

    match /community_post_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.authorId);
    }


    match /post_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.authorId);
    }

    // ---------------------------------------------------------
    // 🖌️ WHITEBOARDS (Excalidraw)
    // ---------------------------------------------------------
    match /whiteboards/{whiteboardId} {
      // Owner: full access
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Public read: anyone can view if the whiteboard is marked public (for community feed links)
      allow read: if resource.data.isPublic == true;
    }

    // ---------------------------------------------------------
    // 💼 JOB POSTINGS (B2B Business Partner)
    // ---------------------------------------------------------
    match /jobPostings/{jobId} {
      // Anyone can read published jobs (public job board).
      allow read: if resource.data.status == 'published' || resource.data.get('status', '') == 'published';
      // Business partners (HR) can read ALL their own job postings (incl. drafts).
      allow read: if request.auth != null && resource.data.hrUserId == request.auth.uid;
      // Admins can read everything.
      allow read: if isAdmin();
      // Only the owning business partner (or admin) can create/update/delete.
      allow create: if isBusinessPartner() || isAdmin();
      allow update, delete: if (isBusinessPartner() && resource.data.hrUserId == request.auth.uid) || isAdmin();
    }

    // ---------------------------------------------------------
    // 📋 JOB APPLICATIONS (B2B Business Partner)
    // ---------------------------------------------------------
    match /jobApplications/{appId} {
      // Applicant can read/edit/delete their own application.
      allow read, update, delete: if request.auth != null && resource.data.applicantUserId == request.auth.uid;
      // Applicant can submit new application.
      allow create: if request.auth != null && request.resource.data.applicantUserId == request.auth.uid;
      // Business partners can read applications for jobs they own.
      allow read: if isBusinessPartner() &&
        exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
        get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.hrUserId == request.auth.uid;
      // Business partners can update status fields on applications for their jobs.
      allow update: if isBusinessPartner() &&
        exists(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)) &&
        get(/databases/$(database)/documents/jobPostings/$(resource.data.jobPostingId)).data.hrUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory', 'hrNotes', 'rating', 'matchAnalysis', 'lastUpdated']);
      // Admins can do everything.
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------
    // 🏢 COMPANY PROFILES (B2B Business Partner)
    // ---------------------------------------------------------
    match /companyProfiles/{profileId} {
      // Public read for the job board embed widget.
      allow read: if true;
      // Business partner can create/update their own profile.
      allow create: if (isBusinessPartner() || isAdmin()) && request.resource.data.hrUserId == request.auth.uid;
      allow update, delete: if (isBusinessPartner() && resource.data.hrUserId == request.auth.uid) || isAdmin();
    }

    // ---------------------------------------------------------
    // 🧭 AGENCY PARTNER PILOT (Candidate Preparation Links)
    // ---------------------------------------------------------
    match /agencyBranches/{branchId} {
      // Public read lets candidate prep links resolve branch branding by slug.
      allow read: if true;
      // Initial branch creation happens through Admin SDK when an agency application is approved.
      allow create: if isAdmin();
      allow update, delete: if isAdmin() ||
        (isAgencyPartner() && resource.data.ownerUserId == request.auth.uid);

      // Candidate invites sent by recruiters. Writes happen server-side only
      // (via the sendAgencyInvite callable using Admin SDK, which bypasses
      // these rules). Reads are limited to the branch owner and admins.
      match /invites/{inviteId} {
        allow read: if isAdmin() ||
          (request.auth != null &&
           get(/databases/$(database)/documents/agencyBranches/$(branchId)).data.ownerUserId == request.auth.uid);
        allow write: if false;
      }
    }

    match /agencyInvites/{inviteId} {
      allow read: if isAdmin() ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/agencyBranches/$(resource.data.agencyBranchId)) &&
         get(/databases/$(database)/documents/agencyBranches/$(resource.data.agencyBranchId)).data.ownerUserId == request.auth.uid);
      allow write: if false;
    }

    match /agencyPrepSessions/{sessionId} {
      // Candidates can create their own prep session for an existing branch.
      allow create: if request.auth != null &&
        request.resource.data.candidateUserId == request.auth.uid &&
        exists(/databases/$(database)/documents/agencyBranches/$(request.resource.data.agencyBranchId)) &&
        request.resource.data.agencyOwnerUserId == get(/databases/$(database)/documents/agencyBranches/$(request.resource.data.agencyBranchId)).data.ownerUserId &&
        request.resource.data.agencySlug == get(/databases/$(database)/documents/agencyBranches/$(request.resource.data.agencyBranchId)).data.slug &&
        request.resource.data.keys().hasOnly([
          'agencyBranchId',
          'agencyOwnerUserId',
          'agencySlug',
          'candidateUserId',
          'candidateName',
          'candidateEmail',
          'resumeId',
          'resumeTitle',
          'resumeSharePath',
          'status',
          'startingScore',
          'latestScore',
          'scoreDelta',
          'positionTags',
          'consentToShare',
          'readinessReport',
          'createdAt',
          'updatedAt',
          'startedAt',
          'sharedAt'
        ]);

      // Candidates see their own prep session. Agency partners see only sessions owned by their branch.
      allow read: if request.auth != null && (
        resource.data.candidateUserId == request.auth.uid ||
        (isAgencyPartner() && resource.data.agencyOwnerUserId == request.auth.uid) ||
        isAdmin()
      );

      // Candidates may update readiness summary and consent fields for their own session.
      allow update: if request.auth != null &&
        resource.data.candidateUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'candidateName',
          'candidateEmail',
          'resumeId',
          'resumeTitle',
          'resumeSharePath',
          'status',
          'startingScore',
          'latestScore',
          'scoreDelta',
          'consentToShare',
          'readinessReport',
          'updatedAt',
          'startedAt',
          'sharedAt'
        ]);

      // Branch owners can maintain recruiter-side tags without editing the
      // candidate-owned resume/share state.
      allow update: if request.auth != null &&
        (isAdmin() || resource.data.agencyOwnerUserId == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'positionTags',
          'updatedAt'
        ]);

      allow delete: if isAdmin();

      // Recruiter-private notes. Visible only to the branch owner who owns
      // this session and to admins. NEVER visible to the candidate. Writes
      // happen via the addRecruiterNote callable using Admin SDK.
      match /notes/{noteId} {
        allow read: if isAdmin() ||
          (request.auth != null &&
           get(/databases/$(database)/documents/agencyPrepSessions/$(sessionId)).data.agencyOwnerUserId == request.auth.uid);
        allow write: if false;
      }

      // Append-only activity timeline. Visible to candidate, branch owner,
      // and admins. Writes happen server-side only (callables and triggers).
      match /events/{eventId} {
        allow read: if isAdmin() ||
          (request.auth != null && (
            get(/databases/$(database)/documents/agencyPrepSessions/$(sessionId)).data.candidateUserId == request.auth.uid ||
            get(/databases/$(database)/documents/agencyPrepSessions/$(sessionId)).data.agencyOwnerUserId == request.auth.uid
          ));
        allow write: if false;
      }
    }

    // ---------------------------------------------------------
    // 🎲 VECTOR LOTTO (New Feature)
    // ---------------------------------------------------------
    // Predictions: anyone can create, only author can read theirs
    match /vectorlotto_predictions/{docId} {
      allow create: if true; // anonymous + authenticated
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.uid || resource.data.userId == null);
      allow update, delete: if false;
    }

    // User profiles: only the user themselves
    match /vectorlotto_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Waitlist: anyone can write (email capture), admin-only read
    match /vectorlotto_waitlist/{emailId} {
      allow create, update: if true;
      allow read, delete: if false; // Admin reads via Firebase Console / Admin SDK
    }
  }
}
