# CLI tool — source of the published `careervivid` npm package. Kept out of
# this repo deliberately; it is developed and published from its own working
# copy. The source was tracked briefly (PR #118) and removed again here, so if
# you need it back it is recoverable from that commit rather than gone:
#   git show 0ff60da8 -- cli/
cli/

vectorlotto/

# Community content MD
community-content/

# Quest question tracker + research working files. The interview questions are
# maintained privately (synced to Firebase), so these reporting/working
# artifacts must never be pushed to the public repo.
data/quest-question-tracker.xlsx
data/quest-tracker/
data/interview-guides/_research-progress.json

# Generated mobile (iOS) question catalog — contains full question content and
# is rebuilt from source on every functions build (prebuild). Keep it private.
functions/src/mobileInterviewGuideQuestions.generated.ts

# Learning curriculum: raw third-party repos cloned by
# scripts/sync-learning-sources.mjs. Never commit these — they're large,
# have their own nested .git, and CareerVivid's own curriculum content lives
# in docs/learning/ and data/learning/ instead. The LICENSES we copy out of
# them stay tracked for compliance record-keeping.
third_party/learning-sources/*/
!third_party/learning-sources/LICENSES/

# ── Video production artifacts ────────────────────────────────────────────────
# Output, not source. 40,000+ render files made `git status` unusable and hid
# real changes among them. The scripts that PRODUCE these stay tracked; only
# what they emit is ignored.
#
# public/system-design-lessons/ is deliberately NOT here — the site serves those
# videos and thumbnails (see src/lib/systemDesignVideoLessons.ts).
scratchpad/
media/
public/assets/system-design-narration/
public/commercial-videos/
public/producthunt-assets/
functions/scratch/
functions/test_*.js
