{
  "hosting": {
    "predeploy": [
      "node scripts/sync-questions-to-firebase.mjs"
    ],
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      // /resume-builder was a marketing page in front of the editor. The editor
      // now opens without an account at /edit/new, so the page in front of it
      // was a step that only cost a click, and it is gone.
      //
      // This has to be a redirect rather than a deletion: /resume-builder is in
      // Google's index, is linked from the README and from off-site posts, and
      // carried the highest priority in the sitemap. A 404 spends every one of
      // those links.
      {
        "source": "/resume-builder",
        "destination": "/edit/new",
        "type": 301
      },
      // /demo fronted the editor with a career-path picker and is indexed by
      // Google as "CareerVivid Resume and Interview Demo", so the search result
      // for the resume builder landed people there rather than in the editor.
      // Its own success path already ended at the editor, so the picker was a
      // step in front of the thing people came for. Pointing straight at
      // /edit/new, not at /resume-builder, to avoid chaining one 301 into
      // another.
      {
        "source": "/demo",
        "destination": "/edit/new",
        "type": 301
      },
      // Points at /edit/new directly, NOT at /resume-builder. Chaining one 301
      // into another URL that itself 301s is worse than a single hop and far
      // worse if the middle hop ever 404s, because a permanent redirect is
      // cached by browsers and intermediaries indefinitely — a mistake here is
      // not fixable by shipping a correction.
      {
        "source": "/resume-templates",
        "destination": "/edit/new",
        "type": 301
      },
      {
        "source": "/jobs/list",
        "destination": "/jobs",
        "type": 301
      },
      {
        "regex": "^/jobs/list/(?P<n>[0-9]+)$",
        "destination": "/jobs/:n",
        "type": 301
      },
      {
        "source": "/en",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/es",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/fr",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/de",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/zh",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/ja",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/ko",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "/(?:en|es|fr|de|zh|ja|ko)/(?P<path>.+)",
        "destination": "/:path",
        "type": 301
      },
      {
        "regex": "/(.+)/$",
        "destination": "/:1",
        "type": 301
      },
      {
        "source": "/topic/ai-job-search-workspace",
        "destination": "/product",
        "type": 301
      },
      {
        "source": "/topic/chrome-extension-job-autofill",
        "destination": "/product",
        "type": 301
      },
      {
        "source": "/auth",
        "destination": "/signin",
        "type": 301
      },
      {
        "source": "/login",
        "destination": "/signin",
        "type": 301
      },
      {
        "source": "/register",
        "destination": "/signup",
        "type": 301
      },
      {
        "source": "/support",
        "destination": "/contact",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          // Content Security Policy, in REPORT-ONLY mode.
          //
          // There was no CSP of any kind before this. Report-Only is the
          // deliberate starting point: the browser evaluates the policy and
          // logs every violation to the console (and to SecurityPolicyViolation
          // events) but blocks nothing, so a rule that turns out to be too
          // tight costs a console warning instead of a blank page for every
          // signed-in user. A policy written from a source grep and shipped
          // enforcing is a policy written from a guess.
          //
          // TO ENFORCE, three things have to change:
          //
          //  1. Collect real violations first. Watch the console on the routes
          //     that load the most third-party code — the editor, the live
          //     voice interview, Google sign-in, Stripe checkout return — for
          //     long enough to see them, and widen the directives that fire.
          //     Nothing below is confirmed against production traffic yet.
          //
          //  2. Remove 'unsafe-inline' from script-src, which is the directive
          //     doing almost none of the work while it is there. That means
          //     the inline JSON-LD and the inline font-loading onload= in
          //     index.html need a per-response nonce or a hash, which Hosting
          //     cannot add to a static file — index.html would have to be
          //     served through a function, or those inline blocks moved into
          //     bundled modules. Until then, enforcing buys very little.
          //     ('unsafe-inline' in style-src is a separate, lesser problem:
          //     Tailwind and the resume templates set inline styles.)
          //
          //  3. Rename the header to Content-Security-Policy. Keep this
          //     Report-Only entry alongside it afterwards, one step tighter
          //     than the enforced one, so the next tightening is measured the
          //     same way rather than shipped blind.
          //
          // Violations currently report only to the browser console; add a
          // report-to endpoint if these need to be aggregated centrally.
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com https://*.firebaseapp.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' blob: https://*.googleapis.com wss://*.googleapis.com https://*.google.com https://*.cloudfunctions.net https://*.run.app https://*.algolia.net https://*.algolianet.com https://api.careervivid.app; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "regex": "^/(?:$|[^.]*$)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/nextjs/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/nextjs/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(eot|otf|ttf|ttc|woff|woff2|font.css)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": "generateSitemap",
        "region": "us-west1"
      },
      {
        "source": "/interview-studio",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/pricing",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      // The crawler entry for the resume builder moved here with the page it
      // describes. Removing the /resume-builder rewrite is part of the same
      // change on purpose: leaving it would have served Googlebot a 200 with a
      // full SEO page at a URL where every human got a 301 — the definition of
      // cloaking, and the version of this change that gets the site penalised
      // rather than just reorganised.
      {
        "source": "/edit/new",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/jobs",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "regex": "^/jobs/[0-9]+$",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/blog",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/demo",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/contact",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/product",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/community/guidelines",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/partners",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/partners/business",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/partners/agency",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/topic/ai-native-developer-portfolios",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/topic/vibe-coding-platform",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/signin",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/signup",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/jobs/open/**",
        "function": "openRecommendedJob",
        "region": "us-west1"
      },
      {
        "source": "/learning",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/learning/**",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/community",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/community/post/**",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/shared/**",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/portfolio/*/edit/**",
        "destination": "/index.html"
      },
      {
        "source": "/portfolio/**",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/whiteboard/**",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/_next/static/**",
        "destination": "/nextjs/_next/static/:splat"
      },
      {
        "source": "/_next/**",
        "destination": "/nextjs/_next/:splat"
      },
      {
        "source": "/j/*",
        "destination": "/nextjs/j/demo.html"
      },
      {
        "source": "/j/*/*",
        "destination": "/nextjs/j/demo/sample.html"
      },
      {
        "source": "/api/publish",
        "function": "publishPost",
        "region": "us-west1"
      },
      {
        "source": "/api/portfolio/init",
        "function": "initPortfolio",
        "region": "us-west1"
      },
      {
        "source": "/api/portfolio/projects",
        "function": "updatePortfolioProjects",
        "region": "us-west1"
      },
      {
        "source": "/api/portfolio/hero",
        "function": "updatePortfolioHero",
        "region": "us-west1"
      },
      {
        "source": "/api/portfolio/assets",
        "function": "uploadPortfolioAsset",
        "region": "us-west1"
      },
      {
        "source": "/api/public/resume/**",
        "function": "publicResumeApi",
        "region": "us-west1"
      },
      {
        "source": "/api/open-revenue",
        "function": "getOpenRevenueStats",
        "region": "us-west1"
      },
      {
        "source": "/vapi-webhook",
        "function": "vapiWebhook",
        "region": "us-west1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "maxVersionRetained": 5
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/sync-shared.mjs\" --check",
        "npm --prefix \"$RESOURCE_DIR\" install --install-links",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.4"
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
