{
  "hosting": {
    "predeploy": [
      "node scripts/sync-questions-to-firebase.mjs"
    ],
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/en",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/es",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/fr",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/de",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/zh",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/ja",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/ko",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "/(?:en|es|fr|de|zh|ja|ko)/(?P<path>.+)",
        "destination": "/:path",
        "type": 301
      },
      {
        "regex": "/(.+)/$",
        "destination": "/:1",
        "type": 301
      },
      {
        "source": "/topic/ai-job-search-workspace",
        "destination": "/product",
        "type": 301
      },
      {
        "source": "/topic/chrome-extension-job-autofill",
        "destination": "/product",
        "type": 301
      },
      {
        "source": "/auth",
        "destination": "/signin",
        "type": 301
      },
      {
        "source": "/login",
        "destination": "/signin",
        "type": 301
      },
      {
        "source": "/register",
        "destination": "/signup",
        "type": 301
      },
      {
        "source": "/support",
        "destination": "/contact",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "regex": "^/(?:$|[^.]*$)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/nextjs/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0, no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/nextjs/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(eot|otf|ttf|ttc|woff|woff2|font.css)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": "generateSitemap",
        "region": "us-west1"
      },
      {
        "source": "/interview-studio",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/pricing",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/blog",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/job-market",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/demo",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/contact",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/product",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/community/guidelines",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/partners",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/partners/business",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/partners/agency",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/topic/ai-native-developer-portfolios",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/topic/vibe-coding-platform",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/signin",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/signup",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/jobs/open/**",
        "function": "openRecommendedJob",
        "region": "us-west1"
      },
      {
        "source": "/learning",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/learning/**",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/community",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/community/post/**",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/shared/**",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/portfolio/*/edit/**",
        "destination": "/index.html"
      },
      {
        "source": "/portfolio/**",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/whiteboard/**",
        "function": "renderSeoContent",
        "region": "us-west1"
      },
      {
        "source": "/_next/static/**",
        "destination": "/nextjs/_next/static/:splat"
      },
      {
        "source": "/_next/**",
        "destination": "/nextjs/_next/:splat"
      },
      {
        "source": "/j/*",
        "destination": "/nextjs/j/demo.html"
      },
      {
        "source": "/j/*/*",
        "destination": "/nextjs/j/demo/sample.html"
      },
      {
        "source": "/api/publish",
        "function": "publishPost",
        "region": "us-west1"
      },
      {
        "source": "/api/portfolio/init",
        "function": "initPortfolio",
        "region": "us-west1"
      },
      {
        "source": "/api/portfolio/projects",
        "function": "updatePortfolioProjects",
        "region": "us-west1"
      },
      {
        "source": "/api/portfolio/hero",
        "function": "updatePortfolioHero",
        "region": "us-west1"
      },
      {
        "source": "/api/portfolio/assets",
        "function": "uploadPortfolioAsset",
        "region": "us-west1"
      },
      {
        "source": "/api/public/resume/**",
        "function": "publicResumeApi",
        "region": "us-west1"
      },
      {
        "source": "/api/open-revenue",
        "function": "getOpenRevenueStats",
        "region": "us-west1"
      },
      {
        "source": "/vapi-webhook",
        "function": "vapiWebhook",
        "region": "us-west1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "maxVersionRetained": 5
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "node \"$PROJECT_DIR/scripts/sync-shared.mjs\" --check",
        "npm --prefix \"$RESOURCE_DIR\" install --install-links",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.4"
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
