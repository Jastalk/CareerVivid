    "developer-tools",
    "publish",
    "portfolio",
    "ai-agent",
    "resume",
    "mcp"
  ],
  "author": "CareerVivid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jastalk/CareerVivid.git",
    "directory": "cli"
  },
  "homepage": "https://careervivid.app",
  "bugs": {
    "url": "https://github.com/Jastalk/CareerVivid/issues"
  },
  "publishConfig": {
    "access": "public"
  }
